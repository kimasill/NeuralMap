{
  "name": "neuralmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @neuralmap/workbench build:vite",
    "check": "pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "dev:api": "node scripts/with-env.mjs pnpm --filter @neuralmap/api dev",
    "dev:workbench": "pnpm --filter @neuralmap/workbench dev",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "db:generate": "pnpm --filter @neuralmap/db db:generate",
    "db:migrate": "node scripts/with-env.mjs pnpm --filter @neuralmap/db db:migrate",
    "db:smoke": "node scripts/with-env.mjs pnpm --filter @neuralmap/db db:smoke",
    "db:smoke:required": "node scripts/with-env.mjs pnpm --filter @neuralmap/db db:smoke:required",
    "db:seed:repo": "node scripts/with-env.mjs pnpm --filter @neuralmap/ingest ingest:repo --id neuralmap",
    "db:seed:repo:dry": "pnpm --filter @neuralmap/ingest ingest:repo --id neuralmap --dry-run",
    "eval:graphrag": "node scripts/evaluate-graphrag.mjs",
    "eval:simulation": "node scripts/evaluate-simulation-continuity.mjs",
    "bench:graphrag-core": "node scripts/benchmark-core-graphrag.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
