{
  "name": "neuralmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @neuralmap/workbench build:vite",
    "check": "pnpm typecheck",
    "typecheck": "tsc -b",
    "db:generate": "pnpm --filter @neuralmap/db db:generate",
    "db:migrate": "pnpm --filter @neuralmap/db db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
