{
  "name": "@neuralmap/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ingest:repo": "tsx src/cli/ingest-repo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@neuralmap/db": "workspace:*",
    "@neuralmap/schema": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
