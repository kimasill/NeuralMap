{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist-types",
    "composite": true,
    "tsBuildInfoFile": "dist-types/.tsbuildinfo",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowImportingTsExtensions": false
  },
  "references": [{ "path": "../../packages/schema" }],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
